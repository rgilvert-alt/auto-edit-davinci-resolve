# DaVinci Resolve scripting env (macOS, Studio).
# Copy to .env and adjust paths for your Resolve version. Confirm each path exists.

RESOLVE_SCRIPT_API="/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting"

# NOTE: On current Resolve installs the working fusionscript.so lives inside the
# app bundle (verified on this machine), not the Libraries path shown in some docs.
RESOLVE_SCRIPT_LIB="/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so"

# Must include Resolve's scripting Modules/ dir so `import DaVinciResolveScript` works.
PYTHONPATH="/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting/Modules"

# Engine defaults (optional overrides)
AUTOEDIT_WHISPER_MODEL="base"
AUTOEDIT_SILENCE_PADDING_S="0.15"
AUTOEDIT_SILENCE_MIN_GAP_S="0.30"
AUTOEDIT_DEFAULT_FPS="24"
